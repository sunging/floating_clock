#include <windows.h>
#include "version.h"
IDI_ICON1 ICON "clock.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION FC_VERSION_TUPLE
 PRODUCTVERSION FC_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Floating Clock"
      VALUE "FileVersion", FC_VERSION
      VALUE "ProductName", "Floating Clock"
      VALUE "ProductVersion", FC_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
